{
  "name": "pr-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local watcher for my CloudSpot PRs and the CI run each one triggers after merge",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fake-argo": "tsx server/fakeArgo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@octokit/rest": "^22.0.1",
    "hono": "^4.13.19",
    "node-notifier": "^12.1.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
